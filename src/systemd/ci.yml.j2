---
# Generated by src/systemd/generate.py
name: "{{ distro_name }}.{{ baseimage_version }} - {{ image_type }}"

'on':
  pull_request:
    paths:
      - "{{ containerfile_path }}"
      - "{{ workflow_path }}"
      - ".github/workflows/reusable-container-build.yml"
  push:
    branches:
      - main
    paths:
      - "{{ containerfile_path }}"
      - "{{ workflow_path }}"
      - ".github/workflows/reusable-container-build.yml"
  schedule:
    - cron: "{{ build_cron }}"
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build_push:
    name: Build and Push container images to quay.io
    permissions:
      contents: read
    uses: ./.github/workflows/reusable-container-build.yml
    with:
      context: "./{{ containerfile_dir }}"
      containerfile: "./{{ containerfile_path }}"
      platforms: "{{ docker_platforms | join(',') }}"
      image_title: "{{ distro_name }} image with {{ image_type }}"
      image_description: "{{ distro_name }} image with {{ image_type }} for Ansible testing using Podman and Molecule"
      project_path: "Containerfiles/systemd"
      documentation_path: "Containerfiles/systemd/README.md"
      tags: |
{% for tag in all_ci_image_tags %}
        {{ ci_image_repo }}:{{ tag }}
{% endfor %}
{% for repo in extra_ci_image_repos %}
        {{ repo }}
{% endfor %}
    secrets:
{% raw %}      registry_username: ${{ secrets.QUAY_USERNAME }}
      registry_password: ${{ secrets.QUAY_PASSWORD }}
{% endraw %}
